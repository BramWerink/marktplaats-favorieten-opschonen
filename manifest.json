{
  "manifest_version": 3,
  "name": "Marktplaats Tweaks",
  "version": "1.2.0",
  "description": "Handige extra's voor Marktplaats: darkmode en het verwijderen van verlopen favorieten.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://www.marktplaats.nl/*"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.marktplaats.nl/*"],
      "js": ["darkmode.js"],
      "css": ["darkmode.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.marktplaats.nl/my-account/favorites/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
